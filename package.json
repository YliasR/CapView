{
  "name": "capview",
  "productName": "CapView",
  "version": "1.2.1",
  "description": "Minimal capture card viewer for sharing in Discord",
  "author": "mystic",
  "homepage": "https://github.com/YliasR/CapView",
  "repository": {
    "type": "git",
    "url": "https://github.com/YliasR/CapView.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "gay.mystic.capview",
    "productName": "CapView",
    "files": [
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "copyright": "Copyright (c) 2026 mystic",
    "publish": {
      "provider": "github",
      "owner": "YliasR",
      "repo": "CapView",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "CapView",
      "uninstallDisplayName": "CapView",
      "license": "LICENSE",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "displayLanguageSelector": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
