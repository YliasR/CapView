{
  "name": "capview",
  "productName": "CapView",
  "version": "1.0.0",
  "description": "Minimal capture card viewer for sharing in Discord",
  "author": "mystic",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "gay.mystic.capview",
    "productName": "CapView",
    "files": [
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "CapView"
    }
  }
}
